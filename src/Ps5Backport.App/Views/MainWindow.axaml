<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ps5Backport.App.ViewModels"
        xmlns:app="using:Ps5Backport.App"
        xmlns:views="using:Ps5Backport.App.Views"
        x:Class="Ps5Backport.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PS5 Backport Studio"
        Icon="/Assets/backport.png"
        Background="{DynamicResource CanvasBrush}"
        Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleRailCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- the rail over the code graph page: a floating panel with a shadow -->
    <Style Selector="Border#Rail.overlay">
      <Setter Property="BoxShadow" Value="4 0 18 0 #99000000" />
    </Style>
  </Window.Styles>

  <Panel>

    <!-- navigation rail: docked beside the page, or over the code graph page (RailDocked / RailRevealed) -->
    <Border Name="Rail" Classes="panel" Classes.overlay="{Binding !RailDocked}" BorderThickness="0,0,1,0" Width="64"
            HorizontalAlignment="Left" ZIndex="2" IsVisible="{Binding RailVisible}">
      <DockPanel Margin="0,10">
        <RadioButton AutomationProperties.Name="Settings" DockPanel.Dock="Bottom" Classes="rail" GroupName="rail" ToolTip.Tip="Settings" IsChecked="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Settings}}">
          <TextBlock Classes="icon" Text="&#xE713;" />
        </RadioButton>
        <StackPanel>
          <Image Source="/Assets/backport.png" Width="44" Height="44" Margin="0,0,0,14"
                 ToolTip.Tip="PS5 Backport Studio" />
          <RadioButton AutomationProperties.Name="Backport" Classes="rail" GroupName="rail" ToolTip.Tip="Backport" IsChecked="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Backport}}">
            <TextBlock Classes="icon" Text="&#xE90F;" />
          </RadioButton>
          <RadioButton AutomationProperties.Name="Compatibility libraries" Classes="rail" GroupName="rail" ToolTip.Tip="Compatibility libraries (fakelibs)" IsChecked="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Store}}">
            <TextBlock Classes="icon" Text="&#xE7B8;" />
          </RadioButton>
          <RadioButton AutomationProperties.Name="Firmware database" Classes="rail" GroupName="rail" ToolTip.Tip="Firmware database" IsChecked="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.FirmwareDb}}">
            <TextBlock Classes="icon" Text="&#xE8A5;" />
          </RadioButton>
          <RadioButton AutomationProperties.Name="Tools" Classes="rail" GroupName="rail" ToolTip.Tip="Tools: SELF files, NID lookup" IsChecked="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Tools}}">
            <TextBlock Classes="icon" Text="&#xEC7A;" />
          </RadioButton>
          <RadioButton AutomationProperties.Name="Code graph" Classes="rail" GroupName="rail" ToolTip.Tip="Code graph: an eboot's functions as graphs, compared with its backport" IsChecked="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.CodeGraph}}">
            <TextBlock Classes="icon" Text="&#xE943;" />
          </RadioButton>
          <RadioButton AutomationProperties.Name="Console results" Classes="rail" GroupName="rail" ToolTip.Tip="Console results: what ran on which firmware, evidence per band, promotion" IsChecked="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Results}}">
            <TextBlock Classes="icon" Text="&#xE9D9;" />
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- the hidden rail's hover edge on the code graph page -->
    <Border Name="RailEdge" Width="8" HorizontalAlignment="Left" Background="Transparent" ZIndex="1" IsVisible="{Binding !RailDocked}" />

    <ThemeVariantScope Margin="{Binding ContentMargin}" Classes.gameArtwork="{Binding HasGameBackground}">
      <ThemeVariantScope.Styles>
        <Style Selector="ThemeVariantScope.gameArtwork">
          <Setter Property="RequestedThemeVariant" Value="Dark" />
        </Style>
      </ThemeVariantScope.Styles>
    <Grid Name="Body" RowDefinitions="Auto,*,4,44">

      <!-- Game artwork stays behind the controls, with a PlayStation-style black fade. -->
      <Panel Grid.RowSpan="4" IsVisible="{Binding HasGameBackground}" IsHitTestVisible="False" ClipToBounds="True">
        <Image Source="{Binding GameBackground}" Stretch="UniformToFill" />
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#80000000" />
              <GradientStop Offset="0.55" Color="#BF000000" />
              <GradientStop Offset="1" Color="#E6000000" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Panel>

      <!-- Game identity, target and actions form separate groups. -->
      <Border Grid.Row="0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="24,20,24,16"
              IsVisible="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Backport}}">
        <Grid ColumnDefinitions="Auto,*,260" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="16">
          <Border Width="88" Height="88" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
            <Panel>
              <TextBlock Classes="icon muted" FontSize="28" HorizontalAlignment="Center" Text="&#xE7FC;" IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}" />
              <Image Source="{Binding Cover}" Stretch="UniformToFill" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
            <TextBlock Classes="caption" Text="SELECTED GAME" />
            <TextBlock Classes="title" Text="{Binding GameTitle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" Text="{Binding GameLine}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GameLine}" />
            <Border IsVisible="{Binding HasPsvr2}" HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" BorderThickness="1"
                    BorderBrush="{DynamicResource StatusWarn}" ToolTip.Tip="{Binding Psvr2Text}">
              <TextBlock Text="PS VR2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarn}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
            <TextBlock Classes="caption" Text="TARGET FIRMWARE" />
            <ComboBox ItemsSource="{Binding Firmwares}" SelectedItem="{Binding SelectedFirmware}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Target firmware" ToolTip.Tip="Firmware installed on your console" />
            <TextBlock Classes="caption" Text="{Binding FakelibText}" TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding FakelibText}" />
          </StackPanel>
          <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Content="Open game" Command="{Binding OpenGameCommand}" MinHeight="36" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <DropDownButton Content="Advanced options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <DropDownButton.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Spacing="6" Width="340">
                      <TextBlock Classes="section" Text="Advanced backport options" />
                      <CheckBox IsChecked="{Binding KnownFixes}" Content="Known fixes (data/fixes.json)" />
                      <CheckBox IsChecked="{Binding CandidateFixes}" Content="AnyPS5 candidate stubs (not console-tested)" />
                      <CheckBox IsChecked="{Binding StubUnknown}" Content="Stub every unknown import" />
                      <CheckBox IsChecked="{Binding DefineSymbol}" Content="Also rewrite stubbed symbols" />
                      <CheckBox IsChecked="{Binding ExtendText}" Content="Extend code segment when padding runs out" />
                      <CheckBox IsChecked="{Binding PatchParam}" Content="Lower param.json versions" />
                    </StackPanel>
                  </Flyout>
                </DropDownButton.Flyout>
              </DropDownButton>
              <Button Name="AnalyzeButton" Content="Analyze game" Command="{Binding AnalyzeCommand}" MinHeight="36"
                      ToolTip.Tip="Check imports and proposed changes without creating a backport" />
              <Button Name="CookButton" Classes="accent" Content="Create backport" Command="{Binding CookCommand}" MinHeight="36"
                      ToolTip.Tip="Write the backport to the output folder" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="card" IsVisible="{Binding IsAnalysisStale}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock Classes="caption" Text="{Binding ResultTargetText}" />
                <TextBlock Text="Analysis needs updating" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarn}" IsVisible="{Binding IsAnalysisStale}" />
                <TextBlock Classes="muted" Text="Settings changed. Analyze again to review the current settings."
                           TextWrapping="Wrap" IsVisible="{Binding IsAnalysisStale}" />
              </StackPanel>
              <Button Grid.Column="1" Content="Analyze again" Command="{Binding AnalyzeCommand}" VerticalAlignment="Center" IsVisible="{Binding IsAnalysisStale}" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- tabs -->
      <TabControl Classes="workbench" Grid.Row="1" Margin="24,12,24,0" SelectedIndex="{Binding SelectedTab}" IsVisible="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Backport}}">
        <TabItem Header="Overview">
          <ScrollViewer>
            <StackPanel Spacing="16" Margin="0,16,0,16">
              <Border Classes="card" IsVisible="{Binding !HasResult}">
                <StackPanel Spacing="4">
                  <TextBlock Classes="section" Text="Start with an analysis" />
                  <TextBlock Classes="muted" Text="Analyze the game to review modules, proposed fixes and unresolved imports before creating the backport." TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="card" IsVisible="{Binding HasPublishedResult}" BorderBrush="{DynamicResource StatusOk}">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="Last published backport" Foreground="{DynamicResource StatusOk}" />
                  <TextBlock Text="{Binding CompletionText}" TextWrapping="Wrap" />
                  <SelectableTextBlock Classes="mono" Text="{Binding PublishedOutput}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="Merge the release into the matching game folder before testing. Build the AMPR index from that same folder." TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AmprIndexWarningText}" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarn}" />
                  <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <Button Content="Open created backport" Command="{Binding OpenPublishedOutputCommand}" />
                    <Button Content="Build AMPR index" Command="{Binding BuildPublishedAmprIndexCommand}" />
                  </WrapPanel>
                  <TextBlock Classes="caption" Text="{Binding AmprIndexText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <TextBlock Classes="caption" Text="{Binding ResultTargetText}" IsVisible="{Binding HasResult}" />
              <UniformGrid Columns="4" IsVisible="{Binding HasResult}">
                <Border Classes="card" Margin="0,0,8,0">
                  <StackPanel><TextBlock Classes="caption" Text="Modules" /><TextBlock Classes="metric" Text="{Binding ModuleCount}" /></StackPanel>
                </Border>
                <Border Classes="card" Margin="0,0,8,0">
                  <StackPanel><TextBlock Classes="caption" Text="Fixes" ToolTip.Tip="Proposed by analysis or applied when creating a backport" /><TextBlock Classes="metric" Text="{Binding FixedCount}" Foreground="{DynamicResource StatusOk}" /></StackPanel>
                </Border>
                <Border Classes="card" Margin="0,0,8,0">
                  <StackPanel><TextBlock Classes="caption" Text="Unresolved imports" /><TextBlock Classes="metric" Text="{Binding UnresolvedCount}" Foreground="{DynamicResource StatusWarn}" /></StackPanel>
                </Border>
                <Border Classes="card" Margin="0,0,8,0">
                  <StackPanel><TextBlock Classes="caption" Text="Not console-tested" /><TextBlock Classes="metric" Text="{Binding DerivedCount}" /></StackPanel>
                </Border>
              </UniformGrid>
              <Border Classes="card" IsVisible="{Binding HasWarnings}">
                <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Warnings" />
                <ItemsControl ItemsSource="{Binding WarningDetails}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WarningRow">
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarn}" Margin="0,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander Header="Show technical details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <ItemsControl ItemsSource="{Binding WarningDetails}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WarningRow">
                        <SelectableTextBlock Classes="mono" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,6" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
                </StackPanel>
              </Border>
              <!-- console evidence of the applied rules, options and fakelib sets (data/console_results.json) -->
              <Border Classes="card" IsVisible="{Binding HasConsoleEvidence}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="section" Text="Console evidence for this cook" />
                      <TextBlock Classes="caption" Text="Runs per firmware band of the forms this cook applies; experimental items without runs show what to send to testers." TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open Console results" Command="{Binding OpenConsoleResultsCommand}" VerticalAlignment="Top" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding ConsoleEvidenceNotes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Classes="banner" Classes.failure="{Binding Converter={x:Static app:StartsWithConverter.Instance}, ConverterParameter=⚠}" Margin="0,0,0,6">
                          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*,90,90,90,90" Margin="0,2">
                    <TextBlock Classes="caption" Text="APPLIED ITEM" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="4.XX" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="5-7" />
                    <TextBlock Grid.Column="3" Classes="caption" Text="8-9" />
                    <TextBlock Grid.Column="4" Classes="caption" Text="10+" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding ConsoleEvidence}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ResultItemRow">
                        <Grid ColumnDefinitions="*,90,90,90,90" Margin="0,3">
                          <StackPanel>
                            <TextBlock Text="{Binding Item}" />
                            <TextBlock Classes="caption mono" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <ContentControl Grid.Column="1" Content="{Binding Band0}" />
                          <ContentControl Grid.Column="2" Content="{Binding Band1}" />
                          <ContentControl Grid.Column="3" Content="{Binding Band2}" />
                          <ContentControl Grid.Column="4" Content="{Binding Band3}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="section" Text="Output folder" />
                      <TextBlock Classes="caption" Text="The backport will be written here." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open output folder" Command="{Binding OpenOutputCommand}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBox Classes="mono" Text="{Binding OutputFolder}" AutomationProperties.Name="Output folder" />
                  <Expander Header="AMPR index and deployment" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="caption" Text="{Binding AmprIndexText}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="After creating the backport, build the index if this release needs AMPR. It indexes the original game and this overlay, excludes private reports and logs, and writes ampr_emu.index in the output folder." TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="For testing, merge the release contents into the matching game folder (overwrite files), then build the index and copy the complete game folder, ampr_emu.index included, to /data/homebrew/&lt;GAME&gt;/ for ShadowMountPlus." TextWrapping="Wrap" />
                      <TextBlock Text="{Binding AmprIndexWarningText}" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarn}" />
                      <Button Content="Build AMPR index" Command="{Binding BuildAmprIndexCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <Expander Header="{Binding PatchOptionsSummary}" IsVisible="{Binding HasGame}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                  <TextBlock Classes="caption" Text="Off by default and not remembered. Analyze probes the game's modules first: a patch the game needs is pre-selected (needed), the others are marked applicable, not applicable or a console choice. Review the warnings, then analyze or create the backport again." TextWrapping="Wrap" />
                  <TextBox Text="{Binding PatchSearch}" PlaceholderText="Search optional patches" MaxWidth="320" HorizontalAlignment="Left" />
                  <!-- one card per area (data/fixes.json option "group"); cards wrap as areas are added -->
                  <ItemsControl ItemsSource="{Binding VisiblePatchGroups}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="10" LineSpacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PatchGroup">
                        <Border Classes="card" Width="280" Padding="10,8">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="{Binding Name}" Margin="2,0,0,2" />
                            <ItemsControl ItemsSource="{Binding Options}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptionRow">
                                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" MinHeight="30" Opacity="{Binding RowOpacity}">
                                    <Button Classes="patchName" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                                            AutomationProperties.Name="{Binding Name}">
                                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                      <ToolTip.Tip>
                                        <StackPanel Spacing="6" MaxWidth="420">
                                          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                          <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarn}" />
                                          <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" IsVisible="{Binding HasVerdict}" />
                                        </StackPanel>
                                      </ToolTip.Tip>
                                    </Button>
                                    <!-- the requirements probe's verdict for this game (empty before Analyze) -->
                                    <Border Grid.Column="1" Classes="status" Classes.ok="{Binding IsNeeded}" Classes.warning="{Binding IsApplicable}"
                                            IsVisible="{Binding HasVerdict}" VerticalAlignment="Center" ToolTip.Tip="{Binding Evidence}"
                                            AutomationProperties.Name="{Binding VerdictLabel}">
                                      <TextBlock Text="{Binding VerdictLabel}" />
                                    </Border>
                                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" OnContent="" OffContent=""
                                                  MinHeight="0" Height="30" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Warning}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="card" Padding="12,8">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding SelectedPatchOption.Name, FallbackValue='Select a patch to see details'}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SelectedPatchOption.HasVerdict, FallbackValue=False}">
                        <TextBlock Classes="caption" Text="Probe" VerticalAlignment="Center" />
                        <Border Classes="status" Classes.ok="{Binding SelectedPatchOption.IsNeeded, FallbackValue=False}"
                                Classes.warning="{Binding SelectedPatchOption.IsApplicable, FallbackValue=False}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding SelectedPatchOption.VerdictLabel, FallbackValue=''}" />
                        </Border>
                        <TextBlock Text="{Binding SelectedPatchOption.Evidence, FallbackValue=''}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="900" />
                      </StackPanel>
                      <TextBlock Classes="muted" Text="{Binding SelectedPatchOption.Description, FallbackValue=''}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SelectedPatchOption.Warning, FallbackValue=''}" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarn}" />
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="4" IsVisible="{Binding IsBootNoticeEnabled}">
                    <TextBlock Classes="caption" Text="Boot notification message. Empty uses the default. Baked into the eboot and shown on the console after the patch's delay." TextWrapping="Wrap" />
                    <TextBox Text="{Binding BootNoticeMessage}" PlaceholderText="Backport test files by Arsenic" MaxWidth="640" HorizontalAlignment="Left" />
                  </StackPanel>
                </StackPanel>
              </Expander>
              <Expander Header="Diagnostics" IsVisible="{Binding HasGame}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Border Classes="card" Classes.optionOn="{Binding AmprDebugLogging}" MaxWidth="780" HorizontalAlignment="Left">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Enable AMPR emulator logging" FontWeight="SemiBold" />
                      <TextBlock Classes="muted" Text="Uses the official logging-enabled ampr_emu build for this test. It writes /app0/ampr_emu.log; send that file with the test result." TextWrapping="Wrap" />
                      <TextBlock Text="Diagnostic only: logging changes timing and performance. Leave off for release backports." TextWrapping="Wrap" Foreground="{DynamicResource StatusWarn}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AmprDebugLogging}" OnContent="" OffContent="" VerticalAlignment="Top" ToolTip.Tip="Enable AMPR emulator logging" />
                  </Grid>
                </Border>
              </Expander>

              <StackPanel Spacing="4" IsVisible="{Binding HasResult}">
                <TextBlock Classes="section" Text="Analysis reference" />
                <TextBlock Classes="muted" Text="{Binding ReferenceText}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Modules" />
              <TextBlock Classes="caption" Text="{Binding ModuleCount}" IsVisible="{Binding HasResult}" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,12,0,0">
            <TextBlock Classes="caption" Text="Select a module to limit the Imports view to that file." TextWrapping="Wrap" />
            <Border Grid.Row="1" Classes="card" Padding="0">
              <Grid>
          <TableView ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" Foreground="{DynamicResource InkBrush}" IsVisible="{Binding HasModules}">
            <TableView.Columns>
              <TableViewColumn Header="Module" Width="*" x:DataType="vm:ModuleRow">
                <TableViewColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ModuleRow">
                    <TextBlock Classes="mono" Text="{Binding Path}" TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding Path}" />
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
              <TableViewColumn Header="Container" Binding="{Binding Container}" Width="140" x:DataType="vm:ModuleRow" />
              <TableViewColumn Header="SDK" Binding="{Binding Sdk}" Width="100" x:DataType="vm:ModuleRow" />
              <TableViewColumn Header="Fixes" Binding="{Binding Fixed}" Width="70" x:DataType="vm:ModuleRow" />
              <TableViewColumn Header="Unresolved" Width="100" x:DataType="vm:ModuleRow">
                <TableViewColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ModuleRow">
                    <TextBlock Text="{Binding Unresolved}" Foreground="{Binding UnresolvedTone, Converter={x:Static app:ToneBrushConverter.Instance}}" />
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
              <TableViewColumn Header="State" Width="130" x:DataType="vm:ModuleRow">
                <TableViewColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ModuleRow">
                    <Border Classes="status" Classes.ok="{Binding HasChanges}" Classes.error="{Binding HasError}" ToolTip.Tip="{Binding StateDescription}">
                      <TextBlock Text="{Binding StateDisplay}" />
                    </Border>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
            </TableView.Columns>
          </TableView>
                <StackPanel Spacing="8" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasModules}">
                  <TextBlock Classes="section" Text="No module results" />
                  <TextBlock Classes="muted" Text="{Binding ModulesEmptyText}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem MinWidth="174">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Imports" />
              <TextBlock Classes="caption" Text="{Binding ImportTabText}" ToolTip.Tip="Count reflects the current module, status and search filters." IsVisible="{Binding HasResult}" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <Grid ColumnDefinitions="*,280" ColumnSpacing="12" Margin="0,12,0,0">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,140,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,0,0,10">
                <TextBox Name="ImportSearchBox" AutomationProperties.Name="Search imports" PlaceholderText="Search function, NID or library" Text="{Binding ImportSearch}" />
                <ComboBox Grid.Column="1" AutomationProperties.Name="Filter import status" ItemsSource="{Binding ImportFilters}" SelectedItem="{Binding ImportFilter}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="2" Content="Show all" ToolTip.Tip="Clear the search, status and module filters" Command="{Binding ClearImportFiltersCommand}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Classes="caption" Text="{Binding ImportCountText}" TextWrapping="Wrap" />
              </Grid>
              <Border Classes="card" Padding="0">
                <Grid>
              <TableView Name="ImportsTable" Foreground="{DynamicResource InkBrush}" IsVisible="{Binding HasImports}" AutomationProperties.Name="Imports" ItemsSource="{Binding Imports}" SelectedItem="{Binding SelectedImport}">
                <TableView.Columns>
                  <TableViewColumn Header="Status" Width="130" x:DataType="vm:ImportRow">
                    <TableViewColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ImportRow">
                        <Border Classes="status" Classes.ok="{Binding IsResolved}" Classes.warning="{Binding IsUnresolved}" ToolTip.Tip="{Binding StatusDescription}">
                          <TextBlock Text="{Binding StatusDisplay}" />
                        </Border>
                      </DataTemplate>
                    </TableViewColumn.CellTemplate>
                  </TableViewColumn>
                  <TableViewColumn Header="Function" Width="*" x:DataType="vm:ImportRow">
                    <TableViewColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ImportRow">
                        <TextBlock Classes="mono" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                      </DataTemplate>
                    </TableViewColumn.CellTemplate>
                  </TableViewColumn>
                  <TableViewColumn Header="Library" Width="120" x:DataType="vm:ImportRow">
                    <TableViewColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ImportRow">
                        <TextBlock Classes="mono" Text="{Binding Library}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Library}" />
                      </DataTemplate>
                    </TableViewColumn.CellTemplate>
                  </TableViewColumn>
                  <TableViewColumn Header="Refs" Binding="{Binding RefsText}" Width="48" x:DataType="vm:ImportRow" />
                  <TableViewColumn Header="Module" Width="100" x:DataType="vm:ImportRow">
                    <TableViewColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ImportRow">
                        <TextBlock Classes="mono" Text="{Binding Module}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Module}" />
                      </DataTemplate>
                    </TableViewColumn.CellTemplate>
                  </TableViewColumn>
                </TableView.Columns>
              </TableView>
                  <StackPanel Spacing="8" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasImports}">
                    <TextBlock Classes="section" Text="No imports to display" />
                    <TextBlock Classes="muted" Text="{Binding ImportsEmptyText}" TextWrapping="Wrap" MaxWidth="400" />
                    <Button Content="Show all imports" Command="{Binding ClearImportFiltersCommand}" IsVisible="{Binding HasResult}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Grid>
              </Border>
            </DockPanel>

            <!-- inspector -->
            <Border Grid.Column="1" Classes="card">
              <ScrollViewer>
              <Panel>
                <TextBlock Classes="muted" Text="Select an import to see what we know about it." TextWrapping="Wrap"
                           IsVisible="{Binding !HasSelectedImport}" />
                <StackPanel Spacing="8" IsVisible="{Binding HasSelectedImport}">
                  <TextBlock Classes="caption" Text="Inspector" />
                  <SelectableTextBlock Classes="mono" FontWeight="Medium" Text="{Binding SelectedImport.Name, FallbackValue=''}" TextWrapping="Wrap" />
                  <SelectableTextBlock Classes="mono" Text="{Binding SelectedImport.Nid, FallbackValue=''}" />
                  <TextBlock Classes="muted" Text="{Binding SelectedImport.Library, FallbackValue=''}" />
                  <TextBlock Text="{Binding SelectedImport.StatusDisplay, FallbackValue=''}" ToolTip.Tip="{Binding SelectedImport.StatusDescription}"
                             Foreground="{Binding SelectedImport.Tone, FallbackValue='muted', Converter={x:Static app:ToneBrushConverter.Instance}}" />
                  <StackPanel IsVisible="{Binding SelectedImport.HasApplied, FallbackValue=False}">
                    <TextBlock Classes="caption" Text="Applied" />
                    <TextBlock Text="{Binding SelectedImport.Applied, FallbackValue=''}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel IsVisible="{Binding SelectedImport.HasFix, FallbackValue=False}">
                    <TextBlock Classes="caption" Text="Known fix" />
                    <TextBlock Text="{Binding SelectedImport.FixSummary, FallbackValue=''}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding SelectedImport.FixNote, FallbackValue=''}" TextWrapping="Wrap" FontSize="12" />
                  </StackPanel>
                  <StackPanel IsVisible="{Binding SelectedImport.HasCandidate, FallbackValue=False}">
                    <TextBlock Classes="caption" Text="Candidate (AnyPS5)" />
                    <TextBlock Text="{Binding SelectedImport.Candidate, FallbackValue=''}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel IsVisible="{Binding SelectedImport.HasLeftBy, FallbackValue=False}">
                    <TextBlock Classes="caption" Text="Left unpatched" />
                    <TextBlock Text="{Binding SelectedImport.LeftByText, FallbackValue=''}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel IsVisible="{Binding SelectedImport.HasIntroduced, FallbackValue=False}">
                    <TextBlock Classes="caption" Text="Introduced" />
                    <TextBlock Text="{Binding SelectedImport.Introduced, FallbackValue=''}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel IsVisible="{Binding SelectedImport.HasRefs, FallbackValue=False}">
                    <TextBlock Classes="caption" Text="Direct code references" />
                    <TextBlock Text="{Binding SelectedImport.RefsText, FallbackValue=''}" />
                  </StackPanel>
                  <Button Content="Show call sites in Code graph" Command="{Binding ShowInCodeGraphCommand}" HorizontalAlignment="Left"
                          ToolTip.Tip="Opens the Code graph page on the functions of this game's eboot.bin that call this import (eboot.bin imports only)" />
                </StackPanel>
              </Panel>
              </ScrollViewer>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="Report">
          <TextBox Classes="mono" Text="{Binding ReportText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Margin="0,8,0,0"
                   PlaceholderText="Analyze the game or create a backport to see the report" />
        </TabItem>
      </TabControl>

      <!-- fakelib store page (7.1, 7.3) -->
      <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Store}}">
        <views:StoreView DataContext="{Binding Store}" />
      </Panel>

      <!-- firmware database page (7.2) -->
      <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.FirmwareDb}}">
        <views:FirmwareDbView DataContext="{Binding Database}" />
      </Panel>

      <!-- tools page (7.4, 7.5) -->
      <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Tools}}">
        <views:ToolsView DataContext="{Binding Tools}" />
      </Panel>

      <!-- code graph page -->
      <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.CodeGraph}}">
        <views:CodeGraphView DataContext="{Binding CodeGraph}" />
      </Panel>

      <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Results}}">
        <views:ConsoleResultsView DataContext="{Binding Results}" />
      </Panel>

      <!-- settings page (6.6): the same options as the flyout, so the last choice is the default -->
      <ScrollViewer Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Page, Converter={x:Static app:PageIsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Settings}}">
        <StackPanel Spacing="4" Margin="24,18" MaxWidth="900">
          <TextBlock Classes="title" Text="Settings" Margin="0,0,0,10" />

          <TextBlock Classes="section" Text="Knowledge folders" Margin="0,4,0,4" />
          <ItemsControl ItemsSource="{Binding PathSettings}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PathSetting">
                <Border Classes="card setting">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <TextBlock Classes="icon" Text="{Binding Icon}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="Medium" Text="{Binding Title}" />
                        <Border Classes="tag"><TextBlock Text="{Binding Source}" /></Border>
                      </StackPanel>
                      <TextBlock Classes="mono muted" Text="{Binding Path}" TextTrimming="PathSegmentEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Status}"
                                 Foreground="{Binding Tone, Converter={x:Static app:ToneBrushConverter.Instance}}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Change" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ChangePathCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="3" Content="Reset" VerticalAlignment="Center" IsVisible="{Binding IsCustom}"
                            ToolTip.Tip="Use the folder found next to the app"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ResetPathCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="section" Text="Defaults for new backports" Margin="0,14,0,0" />
          <TextBlock Classes="caption" Text="The same options as the Advanced options menu; the app remembers what you last used." Margin="0,0,0,4" />
          <Border Classes="card setting">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontWeight="Medium" Text="Target firmware" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Firmwares}" SelectedItem="{Binding SelectedFirmware}" Width="140" />
            </Grid>
          </Border>
          <Border Classes="card setting">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock FontWeight="Medium" Text="Known fixes" /><TextBlock Classes="caption" Text="Stubs, swaps, adapters and argument fixes from data/fixes.json" /></StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding KnownFixes}" OnContent="" OffContent="" />
            </Grid>
          </Border>
          <Border Classes="card setting">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock FontWeight="Medium" Text="Candidate fixes" /><TextBlock Classes="caption" Text="AnyPS5 candidate stubs; not console-tested" /></StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding CandidateFixes}" OnContent="" OffContent="" />
            </Grid>
          </Border>
          <Border Classes="card setting">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock FontWeight="Medium" Text="Stub unknown imports" /><TextBlock Classes="caption" Text="Stub every import still unresolved after the fixes" /></StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding StubUnknown}" OnContent="" OffContent="" />
            </Grid>
          </Border>
          <Border Classes="card setting">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock FontWeight="Medium" Text="Define stubbed symbols" /><TextBlock Classes="caption" Text="Also rewrite stubbed import symbols into local definitions" /></StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding DefineSymbol}" OnContent="" OffContent="" />
            </Grid>
          </Border>
          <Border Classes="card setting">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock FontWeight="Medium" Text="Extend code segment" /><TextBlock Classes="caption" Text="Use the page gap when a module runs out of padding (default; done the same way in two backports, not console-confirmed)" /></StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ExtendText}" OnContent="" OffContent="" />
            </Grid>
          </Border>
          <Border Classes="card setting">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock FontWeight="Medium" Text="Lower param.json versions" /><TextBlock Classes="caption" Text="Set the required firmware and SDK in param.json to the target" /></StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding PatchParam}" OnContent="" OffContent="" />
            </Grid>
          </Border>

          <TextBlock Classes="section" Text="This app" Margin="0,14,0,4" />
          <Border Classes="card setting">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock FontWeight="Medium" Text="Recent games" /><TextBlock Classes="caption" Text="{Binding RecentGamesText}" /></StackPanel>
              <Button Grid.Column="1" Content="Forget" Command="{Binding ClearRecentGamesCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="card setting">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock FontWeight="Medium" Text="Settings file" /><TextBlock Classes="mono muted" Text="{Binding SettingsFile}" /></StackPanel>
              <Button Grid.Column="1" Content="Open folder" Command="{Binding OpenSettingsFolderCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Name="LogSplitter" IsVisible="{Binding #LogToggle.IsChecked}" Grid.Row="2" ResizeDirection="Rows" Background="{DynamicResource HairlineBrush}" />

      <!-- development log -->
      <ThemeVariantScope Grid.Row="3" RequestedThemeVariant="{Binding $parent[Window].ActualThemeVariant}">
      <Border Classes="panel" BorderThickness="0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6" Margin="16,8">
            <ToggleButton Name="LogToggle" Content="Activity log ▸" IsChecked="False" Classes="chip" AutomationProperties.Name="Expand or collapse activity log" ToolTip.Tip="Show or hide the latest 2,000 entries. Status and progress remain visible." VerticalAlignment="Center" Margin="0,0,8,0" />
            <ToggleButton Grid.Column="1" Classes="chip" Content="{Binding Log.ErrorsLabel}" IsChecked="{Binding Log.ShowErrors}"
                          Foreground="{DynamicResource StatusError}" />
            <ToggleButton Grid.Column="2" Classes="chip" Content="{Binding Log.WarningsLabel}" IsChecked="{Binding Log.ShowWarnings}"
                          Foreground="{DynamicResource StatusWarn}" />
            <ToggleButton Grid.Column="3" Classes="chip" Content="All" IsChecked="{Binding Log.ShowAll}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,0,8,0">
              <TextBlock Text="{Binding StatusText}" FontWeight="Medium" VerticalAlignment="Center" />
              <ProgressBar Width="140" Height="6" Value="{Binding Progress}" IsVisible="{Binding Busy}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Name="CancelButton" Grid.Column="5" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" Classes="chip" />
            <Button Grid.Column="6" Content="Copy" Command="{Binding CopyLogCommand}" Classes="chip" />
            <Button Grid.Column="7" Content="Clear" ToolTip.Tip="Clear the displayed history; local diagnostic files remain." Command="{Binding ClearLogCommand}" Classes="chip" />
          </Grid>
          <ListBox IsVisible="{Binding #LogToggle.IsChecked}" Name="LogList" Classes="log" ItemsSource="{Binding Log.Visible}" Background="Transparent" Padding="6,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntry">
                <Grid ColumnDefinitions="64,44,Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="mono muted" Text="{Binding TimeText}" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding LevelText}"
                             Foreground="{Binding Level, Converter={x:Static app:ToneBrushConverter.Instance}}" />
                  <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Module}" Foreground="{DynamicResource StatusPatched}" />
                  <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Message}" TextWrapping="Wrap"
                             Foreground="{Binding Level, Converter={x:Static app:ToneBrushConverter.Instance}}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      </ThemeVariantScope>
    </Grid>
    </ThemeVariantScope>
  </Panel>
</Window>
