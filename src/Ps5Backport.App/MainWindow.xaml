<Window x:Class="Ps5Backport.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ps5Backport.App"
        Title="PS5 Backport Studio" Height="720" Width="1100" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open game folder…" Command="{Binding BrowseCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools" IsEnabled="False" ToolTip="Phase 7: fakelib store, firmware DB, BPS, SELF and NID tools" />
            <MenuItem Header="_Console" IsEnabled="False" ToolTip="Phase 8: FTP upload, logs, payload sender" />
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="Phase 0 shell: analysis and cooking arrive in Phase 6" />
        </StatusBar>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="140" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Game -->
            <GroupBox Header="Game" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="6">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,2" Margin="6,0,0,0"
                                Command="{Binding BrowseCommand}" />
                        <TextBox Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Decrypted game folder (eboot.bin, sce_module, sce_sys)" />
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0" Foreground="Gray"
                               Text="Title, ID, version, icon, SDK and required firmware appear here (Phase 6.1)." />
                </StackPanel>
            </GroupBox>

            <!-- Target and options -->
            <GroupBox Header="Target" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="0,0,0,8" Padding="6">
                <StackPanel>
                    <TextBlock Text="Target firmware" />
                    <ComboBox IsEditable="True" Margin="0,2,0,0" ItemsSource="{Binding Firmwares}"
                              Text="{Binding SelectedFirmware, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding SdkText}" TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,10" />

                    <CheckBox Content="Candidate fixes (AnyPS5, not console-tested)" IsChecked="{Binding CandidateFixes}" />
                    <CheckBox Content="Stub every unknown import" IsChecked="{Binding StubUnknown}" Margin="0,4,0,0" />
                    <CheckBox Content="Extend code segment when padding runs out" IsChecked="{Binding ExtendText}" Margin="0,4,0,0" />
                    <CheckBox Content="Lower param.json versions" IsChecked="{Binding PatchParam}" Margin="0,4,0,0" />

                    <Button Content="Analyze" Margin="0,16,0,0" Padding="0,4" IsEnabled="False" />
                    <Button Content="Cook backport" Margin="0,6,0,0" Padding="0,4" IsEnabled="False" />
                </StackPanel>
            </GroupBox>

            <!-- Analysis -->
            <TabControl Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                <TabItem Header="Modules">
                    <TextBlock Margin="8" Foreground="Gray" Text="Module list: container, SDK before → after, import counts (Phase 6.3)." />
                </TabItem>
                <TabItem Header="Imports">
                    <TextBlock Margin="8" Foreground="Gray" Text="Import grid: status, NID, name, library, refs, introduced, left unpatched by, planned fix (Phase 6.3)." />
                </TabItem>
                <TabItem Header="Report">
                    <TextBlock Margin="8" Foreground="Gray" Text="Backport report (Phase 6.5)." />
                </TabItem>
            </TabControl>

            <!-- Log -->
            <GroupBox Header="Log" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Padding="2">
                <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" BorderThickness="0" />
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
