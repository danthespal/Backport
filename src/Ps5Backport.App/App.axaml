<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ps5Backport.App.App"
             xmlns:vm="using:Ps5Backport.App.ViewModels"
             RequestedThemeVariant="Dark">
  <!-- The pixel BP identity uses a dark terminal palette with magenta and cyan accents. -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StatusOk" Color="#3B6D11" />
          <SolidColorBrush x:Key="StatusPatched" Color="#185FA5" />
          <SolidColorBrush x:Key="StatusWarn" Color="#854F0B" />
          <SolidColorBrush x:Key="StatusError" Color="#A32D2D" />
          <SolidColorBrush x:Key="StatusMuted" Color="#5F5E5A" />
          <SolidColorBrush x:Key="PanelBrush" Color="#F7F7F5" />
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HairlineBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="GapBrush" Color="#FAEEDA" />
          <SolidColorBrush x:Key="CanvasBrush" Color="#F5F2FA" />
          <SolidColorBrush x:Key="InkBrush" Color="#21192D" />
          <SolidColorBrush x:Key="CyanBrush" Color="#007C8B" />
          <SolidColorBrush x:Key="MagentaBrush" Color="#AC167F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="StatusOk" Color="#91E9A5" />
          <SolidColorBrush x:Key="StatusPatched" Color="#5DE9F5" />
          <SolidColorBrush x:Key="StatusWarn" Color="#F6C56B" />
          <SolidColorBrush x:Key="StatusError" Color="#FF8C9E" />
          <SolidColorBrush x:Key="StatusMuted" Color="#ADA8BD" />
          <SolidColorBrush x:Key="PanelBrush" Color="#0E0D16" />
          <SolidColorBrush x:Key="CardBrush" Color="#151320" />
          <SolidColorBrush x:Key="HairlineBrush" Color="#3E344E" />
          <SolidColorBrush x:Key="GapBrush" Color="#4B361B" />
          <SolidColorBrush x:Key="CanvasBrush" Color="#090910" />
          <SolidColorBrush x:Key="InkBrush" Color="#F2EEF8" />
          <SolidColorBrush x:Key="CyanBrush" Color="#5DE9F5" />
          <SolidColorBrush x:Key="MagentaBrush" Color="#EE53BE" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
      <FontFamily x:Key="UiFont">Segoe UI, Inter, sans-serif</FontFamily>
      <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
      <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>

  <!-- console evidence of one item in one firmware band: pass / fail / unknown counts, old runs dashed, "—" without runs -->
  <Application.DataTemplates>
    <DataTemplate x:DataType="vm:BandCell">
      <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
        <TextBlock Text="—" Foreground="{DynamicResource HairlineBrush}" IsVisible="{Binding IsEmpty}" />
        <Border Classes="count pass" IsVisible="{Binding HasPass}" ToolTip.Tip="pass (current form)"><TextBlock Text="{Binding Pass}" /></Border>
        <Border Classes="count fail" IsVisible="{Binding HasFail}" ToolTip.Tip="fail (current form)"><TextBlock Text="{Binding Fail}" /></Border>
        <Border Classes="count unknown" IsVisible="{Binding HasUnknown}" ToolTip.Tip="unknown (current form)"><TextBlock Text="{Binding Unknown}" /></Border>
        <Border Classes="count old" IsVisible="{Binding HasOld}" ToolTip.Tip="old form or unpinned: history only"><TextBlock Text="{Binding Old}" /></Border>
      </StackPanel>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#EE53BE" RegionColor="#090910"
                               ChromeLow="#151320" ChromeMediumLow="#1D1929" ChromeMedium="#3E344E"
                               ChromeHigh="#ADA8BD" BaseHigh="#F2EEF8" />
        <ColorPaletteResources x:Key="Light" Accent="#AC167F" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Ps5BackportStudio/Styles.axaml" />
  </Application.Styles>
</Application>
